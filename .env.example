# Hephaistos 3D — copier en .env (jamais commité). Toutes les valeurs sont validées au démarrage.

# --- Emplacements dans les conteneurs (volumes de compose.yaml)
HEPHAISTOS_DATA_DIR=/data
HEPHAISTOS_MODELS_ROOT=/models

# --- Exposition (D5 / ADR-0009) : localhost seulement par défaut
HEPHAISTOS_BIND_ADDR=127.0.0.1
HEPHAISTOS_PORT=3030
# Propriétaire des fichiers de var/ (bind mounts)
HEPHAISTOS_UID=1000
HEPHAISTOS_GID=1000

# --- Workers et concurrence GPU
GPU_WORKERS=1
GPU_MAX_CONCURRENT_JOBS=1

# --- Partage du GPU. Une génération démarrée n'est jamais interrompue pour céder le GPU : ces
# réglages décident seulement si un job PEUT démarrer, et jusqu'où il peut s'étendre.
# VRAM libre exigée avant de prendre un job (Idol : pic ≈ 7,3 Gio, contexte CUDA compris)
GPU_MIN_FREE_VRAM_MB=8192
# Plafond de VRAM du processus d'inférence (0 = aucun). Au-delà, l'OOM reste dans Hephaistos.
GPU_VRAM_LIMIT_MB=0
# Attente maximale de VRAM avant échec GPU_UNAVAILABLE (0 = attendre indéfiniment)
GPU_WAIT_TIMEOUT_SECONDS=0
# Libération du modèle (fin du processus d'inférence) après inactivité (0 = jamais)
MODEL_IDLE_UNLOAD_SECONDS=900

# --- Suspension des nouvelles générations au démarrage (pilotable ensuite par l'API)
DISPATCH_PAUSED=false

# --- Idol
# full = torch.compile ; no_compile = optimisations sans compilation ; eager = aucune optimisation
IDOL_EXEC_MODE=full
IDOL_DINOV3_DTYPE=bf16

# --- Relances (D8 : seulement les erreurs transitoires identifiées)
JOB_MAX_RETRIES=3
JOB_RETRY_BACKOFF_SECONDS=30
JOB_RETRY_BACKOFF_MAX_SECONDS=900
JOB_LEASE_SECONDS=60
JOB_TIMEOUT_SECONDS=1800
WORKER_SHUTDOWN_GRACE_SECONDS=90
# Délai Docker, strictement supérieur au délai du superviseur
WORKER_STOP_GRACE_SECONDS=120

# --- Stockage
STORAGE_RETENTION_DAYS=30
STORAGE_CLEANUP_INTERVAL_HOURS=24
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_PIXELS=40000000

# --- Développement
ENABLE_FAKE_ADAPTER=false

# --- Sécurité HTTP : générer un secret, ne pas conserver un exemple public
# python -c "import secrets; print(secrets.token_urlsafe(32))"
# L'API refuse de démarrer tant que ce champ est vide. Ne jamais exposer ce jeton au navigateur.
API_ACCESS_TOKEN=
API_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],api
API_ALLOWED_ORIGINS=http://localhost:3030,http://127.0.0.1:3030,http://[::1]:3030
API_JSON_MAX_BYTES=65536
API_REQUEST_TIMEOUT_SECONDS=30
UPLOAD_MAX_CONCURRENT=1
QUEUE_MAX_ACTIVE=100
STORAGE_MAX_BYTES=21474836480
STORAGE_MIN_FREE_BYTES=1073741824
GENERATION_RESULT_BUDGET_BYTES=134217728
LOGS_TAIL_MAX_BYTES=1048576

# --- Frontend P3 : exclusivement côté serveur, sans préfixe NEXT_PUBLIC
# En développement local ; Compose utilisera http://api:8000 lorsque le frontend sera ajouté.
HEPHAISTOS_API_URL=http://127.0.0.1:8000
FRONTEND_ALLOWED_ORIGINS=http://localhost:3030,http://127.0.0.1:3030,http://[::1]:3030
